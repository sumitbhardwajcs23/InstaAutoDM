# Instagram Auto-Reply SaaS Configuration

PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/instautoreply.db
# Neon / PostgreSQL connection string (when using cloud PostgreSQL)
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-xxxx.us-east-1.aws.neon.tech/replyos?sslmode=require

# Encryption (32-character key for AES-256 token encryption)
# DO NOT use this example value anywhere real — it's public since this file is committed
# to the repo. Generate your own with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=01234567890123456789012345678901

# Meta Developer App Settings
# Set META_MOCK_MODE=false to use live Meta Graph API endpoints
META_MOCK_MODE=true
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Instagram API with Instagram Login (native instagram.com login) issues its OWN
# app id/secret pair, separate from META_APP_ID/META_APP_SECRET above.
# Find both under Meta Developer Portal > your app > Instagram > API setup.
# BOTH must be set together, or the OAuth callback fails with
# "Error validating client secret" and the account never shows as connected.
META_IG_APP_ID=your_instagram_app_id_here
META_IG_APP_SECRET=your_instagram_app_secret_here

META_VERIFY_TOKEN=instagram_autoreply_verify_token_2026
META_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback
META_SCOPES=instagram_basic,instagram_manage_comments,instagram_manage_messages,pages_show_list,pages_read_engagement,pages_manage_metadata

# Free Plan DM limits
FREE_PLAN_DM_LIMIT=750
